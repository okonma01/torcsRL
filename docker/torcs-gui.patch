+// Start a configured graphical race without timing-dependent menu key presses.
+void ReRunRaceOnScreen(const char* raceconfig)
+{
+    ReInit();
+    ReInfo->_reMenuScreen = GfuiScreenCreate();
+    ReStateInit(ReInfo->_reMenuScreen);
+    ReInfo->params = GfParmReadFile(raceconfig, GFPARM_RMODE_STD);
+    if (!ReInfo->params) {
+        GfError("Could not open graphical race: %s\n", raceconfig);
+        exit(1);
+    }
+    const char *name = strrchr(raceconfig, '/');
+    name = name ? name + 1 : raceconfig;
+    const char *extension = strrchr(name, '.');
+    ReInfo->_reFilename = strndup(name, extension ? extension - name : strlen(name));
+    ReInfo->_reName = GfParmGetStr(ReInfo->params, RM_SECT_HEADER, RM_ATTR_NAME, "Practice");
+    ReInitResults();
+    ReStateApply((void *) RE_STATE_EVENT_INIT);
+}
 
